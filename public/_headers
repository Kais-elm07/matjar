# Security and caching headers for the static site.
# They are copied with the public folder to out/ during the build, and Netlify and Cloudflare Pages read them automatically.
# GitHub Pages doesn't support custom headers, and cPanel hosting sets them in an .htaccess file (see DEPLOYMENT.md).
#
# The content security policy (CSP) allows only the site's own files, while allowing the inline scripts and styles
# that Next.js needs in the static site. When you turn on analytics (src/config/site.ts), add the tool's domain
# to script-src and connect-src, such as https://plausible.io

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# JavaScript, CSS and font files carry a hash in their names, so the browser caches them for a full year
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images may be replaced under the same name, so they are cached for one day
/images/*
  Cache-Control: public, max-age=86400

# Share images change with prices and names, so they are cached for an hour
/og/*
  Cache-Control: public, max-age=3600

# Prices, stock and the search index must update as soon as any change is published
/cart-catalog.json
  Cache-Control: public, max-age=0, must-revalidate
/search-index.json
  Cache-Control: public, max-age=0, must-revalidate
