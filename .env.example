# ======================================================================
# Environment variables for the store
# Copy this file to a file named .env, then edit the values:
#   cp .env.example .env
# .env is not in Git, because it may hold secrets. On the host, set the same variables in its dashboard.
# ======================================================================

# The base URL of the published site, without a / at the end.
# Used in share links (Open Graph) and in the sitemap for search engines.
# Variables that start with NEXT_PUBLIC_ are written into the site at build time and reach the browser,
# so never put a secret in one.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The PostgreSQL database that keeps the orders. It is read only by the server, never by the browser.
# Locally: the database pnpm db:start runs (port 5433, no password, this machine only).
# On the host: the address of the hosted database. For Supabase, DEPLOYMENT.md shows which string to copy
# and the ending it needs.
DATABASE_URL="postgresql://postgres@localhost:5433/matjar"

# The admin panel (/admin/): the password's hash and the secret that signs the sign-in cookie.
# Make both with pnpm admin:password; without them the panel stays off. The browser tests set their own.
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Uploading product photos in the admin panel, to a public bucket named product-images in Supabase Storage
# (DEPLOYMENT.md). SUPABASE_URL is the project's address, such as https://<project-ref>.supabase.co, and is
# public: it appears in every photo's address. SUPABASE_SECRET_KEY (sb_secret_...) is secret and read only by
# the server. Without both, the panel takes only paths of photos in public/images. The browser tests set
# their own, pointing at a fake storage.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Demo switches, to see the store's loading, error and empty states (README: "See every state").
# "delay=3000", "fail=500" or "empty=1": the browser adds them to its requests to the products API and the
# two data files, and the server obeys them only outside production (pnpm dev). Restart pnpm dev after
# changing it. Leave it empty for the normal store, and never set it on the host.
NEXT_PUBLIC_DEMO_SWITCHES=""
