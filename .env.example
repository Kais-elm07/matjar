# ======================================================================
# Environment variables for the store
# Copy this file to a file named .env, then edit the values:
#   cp .env.example .env
# The site is fully static, so every variable here is embedded in the files at build time.
# Never put a secret key here, because everything in the site reaches the visitor's browser.
# ======================================================================

# The base URL of the published site, without a / at the end.
# Used in share links (Open Graph) and in the sitemap for search engines.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
