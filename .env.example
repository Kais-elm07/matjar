# ======================================================================
# Environment variables for the store
# Copy this file to a file named .env, then edit the values:
#   cp .env.example .env
# .env is not in Git, because it may hold secrets. On the host, set the same variables in its dashboard.
# ======================================================================

# The base URL of the published site, without a / at the end.
# Used in share links (Open Graph) and in the sitemap for search engines.
# Variables that start with NEXT_PUBLIC_ are written into the site at build time and reach the browser,
# so never put a secret in one.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The PostgreSQL database that keeps the orders. It is read only by the server, never by the browser.
# Locally: the database pnpm db:start runs (port 5433, no password, this machine only).
# On the host: the address of the hosted database. For Supabase, DEPLOYMENT.md shows which string to copy
# and the ending it needs.
DATABASE_URL="postgresql://postgres@localhost:5433/matjar"
