# ======================================================================
# متغيرات البيئة للمتجر
# انسخ هذا الملف إلى ملف باسم .env ثم عدّل القيم:
#   cp .env.example .env
# ملف .env لا يُرفع إلى Git لأنه قد يحتوي أسراراً. هذا الملف (.env.example) يُرفع كمرجع فقط.
# كل مرحلة جديدة من الخطة تضيف متغيراتها هنا مع شرح لها.
# ======================================================================

# ---------- قاعدة البيانات (PostgreSQL) ----------
# التطوير المحلي: القاعدة التي يشغّلها الأمر pnpm db:start
# (المنفذ 5433، بدون كلمة مرور، تعمل على جهازك فقط).
# الإنتاج: رابط قاعدة البيانات المستضافة، ويُضبط في لوحة الاستضافة وليس هنا.
DATABASE_URL="postgresql://postgres@localhost:5433/matjar"

# ---------- الموقع ----------
# الرابط الأساسي للموقع بدون / في النهاية.
# يُستخدم في روابط المشاركة (Open Graph) وخريطة الموقع لمحركات البحث.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
