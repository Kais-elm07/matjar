// The store's database: the orders placed at checkout (src/lib/checkout/actions.ts), and the catalog
// (categories, products, their photos and variants), filled from src/data by pnpm db:seed (prisma/seed.ts),
// and the photos uploaded in the admin panel.
// Amounts are in halalas (1 riyal = 100 halalas), as everywhere in the code.
// After changing this file: pnpm db:migrate, which writes a migration in prisma/migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShippingMethod {
  standard
  express
}

model Order {
  /// Long and unguessable: the confirmation page's address (/orders/<id>/)
  id             String         @id @default(cuid())
  /// Short, for the customer to quote, such as 261107-4827
  number         String         @unique
  /// The random id the checkout gave this order, sent again with every retry, so an order whose answer
  /// was lost on the way is not saved twice; null for the orders saved before this field
  requestId      String?        @unique
  /// The visitor's network address when the host reports it, to count the orders one sender saves in
  /// an hour (reachedOrderLimit in src/lib/checkout/orders.ts)
  clientIp       String?
  placedAt       DateTime       @default(now())
  customerName   String
  phone          String
  email          String?
  city           String
  /// The district and the street, as the confirmation shows them
  address        String
  notes          String?
  shippingMethod ShippingMethod
  /// When the order should arrive, as shown at checkout, such as "2-4 أيام عمل"
  deliveryTime   String
  couponCode     String?
  subtotal       Int
  discount       Int
  shippingFee    Int
  total          Int
  lines          OrderLine[]

  @@index([clientIp, placedAt])
  @@map("orders")
}

model OrderLine {
  id       Int    @id @default(autoincrement())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku      String
  /// The product's slug and name when ordered, so the line still reads well if the product changes later
  slug     String
  name     String
  /// The chosen options, such as { "المقاس": "M", "اللون": "أبيض" }
  options  Json
  quantity Int
  /// The price of one piece when ordered
  price    Int
  /// The product photo's path without a size, such as /images/products/shirt-1
  imageSrc String?
  imageAlt String?

  @@index([orderId])
  @@map("order_lines")
}

model Category {
  id          Int        @id @default(autoincrement())
  /// The category's address, such as men in /category/men/
  slug        String     @unique
  name        String
  description String?
  /// The cover photo's path without a size, such as /images/products/shirt-1; null picks the photo of
  /// the category's most popular product
  imageSrc    String?
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  /// The order in menus and lists, from 0
  position    Int        @default(0)
  products    Product[]

  @@map("categories")
}

model Product {
  id          Int            @id @default(autoincrement())
  /// The product's address, such as classic-cotton-shirt in /product/classic-cotton-shirt/
  slug        String         @unique
  name        String
  categoryId  Int
  category    Category       @relation(fields: [categoryId], references: [id])
  description String         @default("")
  /// The specifications table: [{ "label": "الخامة", "value": "قطن" }]
  specs       Json           @default("[]")
  /// Higher sells more: the order of "الأكثر مبيعاً" (best selling)
  popularity  Int            @default(0)
  /// The day the product was added, for "الأحدث" (newest)
  createdAt   DateTime       @db.Date
  /// The deal's last day, in the store's time zone; after it, each variant goes back to compareAtPrice
  saleEndsAt  DateTime?      @db.Date
  /// Hidden products are kept for the orders that name them, but no page shows them
  hidden      Boolean        @default(false)
  /// The order products were written in, which the default lists keep
  position    Int            @default(0)
  updatedAt   DateTime       @updatedAt
  images      ProductImage[]
  variants    Variant[]

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The order in the gallery, from 0; the first is the product's main photo
  position  Int
  /// The path without a size, such as /images/products/shirt-1 or an uploaded photo's address in
  /// Supabase Storage (the loader adds -400.webp and so on)
  src       String
  /// The description for screen readers; null builds it from the product's name and the photo's color
  alt       String?
  /// The color option this photo shows, such as "أبيض" (white), or null for any color
  color     String?
  /// The color of the light behind the photo, such as #c2410c: the owner's choice, or else the color
  /// pnpm images measured in it; null takes the store's blue
  tone      String?
  /// A cut-out photo (transparent background) stands on the stage; others get a frame
  cutout    Boolean @default(false)

  @@unique([productId, position])
  @@map("product_images")
}

/// A photo the store owner uploaded in the admin panel (src/lib/admin/uploads.ts), with the look sharp
/// measured in it, so the product it is added to takes its tone and cut-out when it is saved
model UploadedImage {
  id         Int      @id @default(autoincrement())
  /// The public address of its copies in Supabase Storage, without the size (as ProductImage.src)
  src        String   @unique
  /// The photo's main color, such as #c2410c, or null when it has none
  tone       String?
  cutout     Boolean  @default(false)
  uploadedAt DateTime @default(now())

  @@map("uploaded_images")
}

model Variant {
  id             Int     @id @default(autoincrement())
  productId      Int
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String  @unique
  /// The chosen value of each option, such as { "المقاس": "M", "اللون": "أبيض" }, or {} for none
  options        Json    @default("{}")
  /// The same options as one sorted text (optionsKey), so a product can't have one combination twice
  optionsKey     String
  price          Int
  /// The price before the discount, when the variant is on sale
  compareAtPrice Int?
  stock          Int
  /// The order in the options picker, from 0
  position       Int

  @@unique([productId, optionsKey])
  @@map("variants")
}
