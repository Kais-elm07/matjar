// مخطط قاعدة بيانات المتجر.
// كل مرحلة من الخطة تضيف نماذجها هنا، ثم تُنشئ ترحيلاً جديداً بالأمر: pnpm db:migrate
// التوثيق: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// أدوار المستخدمين وصلاحياتهم.
enum Role {
  /// عميل يتسوق من المتجر
  CUSTOMER
  /// موظف يدير الطلبات والمنتجات دون الإعدادات المالية
  STAFF
  /// مدير المتجر بكامل الصلاحيات
  ADMIN
}

/// مستخدمو المتجر: العملاء والموظفون والمديرون.
/// حقول تسجيل الدخول الإضافية تُضاف في مرحلة الحسابات (المرحلة 4).
model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  phone        String?
  /// كلمة المرور مشفرة دائماً، ولا تُخزن كنص واضح أبداً
  passwordHash String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
