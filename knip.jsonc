{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  // knip (pnpm knip) fails when a file, an export or a package is no longer used.
  // The entries below are used only by tools or generated files, which knip cannot see.
  "entry": [
    // The Prisma CLI reads this file by name (Prisma 7 looks for prisma7.config.ts)
    "prisma7.config.ts",
    // playwright.config.ts starts it as a server, by its path in a command
    "tests/e2e/fake-storage.ts",
  ],
  "ignore": [
    // vitest.config.mts maps "server-only" to this empty file in the unit tests
    "tests/unit/support/empty.ts",
    // vitest.config.mts puts it in place of src/lib/catalog/load.ts, to build the catalog from src/data
    "tests/unit/support/catalog-load.ts",
  ],
  "ignoreDependencies": [
    // next.config.ts names it as the Turbopack loader for the CSS files
    "@tailwindcss/turbopack",
    // Imported by the Prisma client generated in src/generated/prisma, which is not in Git
    "@prisma/client",
  ],
}
